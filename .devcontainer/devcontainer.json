{
  "name": "React + Convex App",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:1-bookworm",
  
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "24"
    },
    "ghcr.io/devcontainers/features/git:1": {}
  },
  
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "bradlc.vscode-tailwindcss"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode"
      }
    }
  },
  
  "postCreateCommand": "npm install && cd .codespace-agent && npm install",
  "postStartCommand": "cd .codespace-agent && CODESPACE_AGENT_TOKEN=${CODESPACE_AGENT_TOKEN} npm start &",
  
  "forwardPorts": [5173, 3000, 1455],
  "portsAttributes": {
    "5173": {
      "label": "Vite Dev Server",
      "onAutoForward": "notify"
    },
    "3000": {
      "label": "Codespace Agent API",
      "visibility": "private",
      "onAutoForward": "silent"
    },
    "1455": {
      "label": "Codex OAuth Callback",
      "visibility": "private",
      "onAutoForward": "silent"
    }
  },
  
  "remoteEnv": {
    "WORKSPACE_DIR": "/workspaces/${localWorkspaceFolderBasename}"
  }
}
