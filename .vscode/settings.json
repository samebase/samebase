{
  "editor.formatOnSave": true,
  "editor.formatOnSaveMode": "file",
  "editor.defaultFormatter": "oxc.oxc-vscode",
  "files.associations": {
    "*.css": "tailwindcss"
  },
  "oxc.fmt.configPath": "./vite.config.ts",
  "tailwindCSS.experimental.configFile": {
    "apps/noter/src/index.css": "apps/noter/src/**",
    "apps/noter-starter-template/src/index.css": "apps/noter-starter-template/src/**"
  },
  "[typescript]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[javascript]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[json]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[jsonl]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  }
}
