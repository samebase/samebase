ARG BASE_IMAGE=mcr.microsoft.com/devcontainers/javascript-node:24-bookworm
FROM ${BASE_IMAGE}

ARG WORKSPACE_DIR=/home/daytona/workspace
ARG REPO_NAME=noter
ARG PNPM_VERSION=9.15.0
ARG CODEX_CLI_VERSION=0.114.0

WORKDIR ${WORKSPACE_DIR}/${REPO_NAME}

RUN apt-get update && apt-get install -y --no-install-recommends fish make tmux && rm -rf /var/lib/apt/lists/*
RUN fish_path="$(command -v fish)" && usermod -s "$fish_path" root && if id -u daytona >/dev/null 2>&1; then usermod -s "$fish_path" daytona; fi

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
