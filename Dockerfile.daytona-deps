ARG BASE_IMAGE=mcr.microsoft.com/devcontainers/javascript-node:24-bookworm
FROM ${BASE_IMAGE}

ARG WORKSPACE_DIR=/home/daytona/workspace
ARG REPO_NAME=noter
ARG PNPM_VERSION=9.15.0

WORKDIR ${WORKSPACE_DIR}/${REPO_NAME}

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/noter/package.json apps/noter/package.json
COPY apps/noter-starter-template/package.json apps/noter-starter-template/package.json

RUN corepack enable && corepack prepare pnpm@${PNPM_VERSION} --activate
RUN pnpm install --prod=false --force --node-linker=hoisted

COPY . ./
