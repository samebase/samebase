{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "lib": ["ES2022"],
    "types": ["node"],
    "typeRoots": ["./apps/samebase/node_modules/@types"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": [
    "scripts/**/*.ts",
    "runtime/**/*.ts",
    ".devcontainer/postcreate.ts",
    "apps/samebase/scripts/**/*.ts",
    "apps/samebase/postcss.config.ts",
    "apps/samebase/tailwind.config.ts"
  ],
  "exclude": ["node_modules"]
}
