{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "types": ["node"],
    "typeRoots": ["./apps/noter/node_modules/@types"],
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": [
    "scripts/**/*.js",
    "scripts/**/*.mjs",
    "runtime/**/*.js",
    "apps/noter/scripts/**/*.js",
    "apps/noter/convex-dev.js",
    "apps/noter/predev.js",
    "apps/noter-starter-template/scripts/**/*.mjs",
    "apps/noter-starter-template/postcss.config.js",
    "apps/noter-starter-template/tailwind.config.js"
  ],
  "exclude": ["node_modules"]
}
