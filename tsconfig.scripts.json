{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "lib": ["ES2022"],
    "types": ["node"],
    "typeRoots": ["./apps/noter/node_modules/@types"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": [
    "scripts/**/*.ts",
    "runtime/**/*.ts",
    "apps/noter/scripts/**/*.ts",
    "apps/noter-agent-template/scripts/**/*.ts",
    "apps/noter-starter-template/scripts/**/*.ts",
    "apps/noter/postcss.config.ts",
    "apps/noter/tailwind.config.ts",
    "apps/noter-starter-template/postcss.config.ts",
    "apps/noter-starter-template/tailwind.config.ts"
  ],
  "exclude": ["node_modules"]
}
