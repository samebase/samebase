{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": ["CONVEX_DEPLOY_KEY", "CONVEX_AGENT_MODE", "DEV_ENV_ORIGIN"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "preview": {
      "dependsOn": ["build"],
      "cache": false
    },
    "clean": {
      "cache": false
    }
  }
}
