{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**"]
    },
    "build:ci": {
      "dependsOn": ["^build:ci"],
      "outputs": ["dist/**", ".next/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": [
        "CONVEX_DEPLOY_KEY",
        "CONVEX_AGENT_MODE",
        "DEV_ENV_ORIGIN",
        "NOTER_DEV_ALLOWED_HOSTS",
        "NOTER_DEV_PORT",
        "NOTER_DEV_STRICT_PORT",
        "VITE_PORT",
        "NOTER_DAYTONA_BROWSER_CONVEX_PROXY_TARGET"
      ]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "lint:ci": {
      "dependsOn": ["^build:ci"]
    },
    "preview": {
      "dependsOn": ["build"],
      "cache": false
    },
    "clean": {
      "cache": false
    }
  }
}
