{
  "name": "identity-hub",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "convex dev",
    "deploy": "node ./scripts/check-keys.ts && convex deploy --yes",
    "keys:init": "node ./scripts/init-keys.ts",
    "typecheck": "tsc --project convex/tsconfig.json && tsc --project tsconfig.node.json",
    "lint": "pnpm --dir ../.. exec vp lint --tsconfig apps/identity-hub/convex/tsconfig.json --report-unused-disable-directives apps/identity-hub/convex apps/identity-hub/scripts apps/identity-hub/alchemy.run.ts",
    "check": "pnpm run typecheck && pnpm run lint"
  },
  "dependencies": {
    "@samebase/alchemy-convex": "0.19.0",
    "@samebase/identity-broker": "0.11.0",
    "convex": "1.48.0"
  },
  "devDependencies": {
    "@effect/platform-node": "4.0.5",
    "@types/node": "24.19.2",
    "alchemy": "2.0.0-beta.84",
    "effect": "4.0.5",
    "typescript": "7.0.2"
  }
}
