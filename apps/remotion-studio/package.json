{
  "name": "@samebase/remotion-studio",
  "version": "0.0.0",
  "private": true,
  "description": "Samebase motion design and video composition workbench",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "remotion bundle",
    "check": "pnpm run typecheck && pnpm run lint",
    "dev": "remotion studio",
    "lint": "pnpm --dir ../.. exec vp lint --tsconfig apps/remotion-studio/tsconfig.json --report-unused-disable-directives apps/remotion-studio/src",
    "render:logo-hype": "remotion render LogoHype out/logo-hype.mp4",
    "render:tic-tac-toe": "remotion render TicTacToeRecording out/tic-tac-toe-master.mp4",
    "typecheck": "pnpm --dir ../.. exec tsgo -p apps/remotion-studio/tsconfig.json --pretty false"
  },
  "dependencies": {
    "@react-three/fiber": "9.6.1",
    "@remotion/cli": "4.0.489",
    "@remotion/three": "4.0.489",
    "@samebase/logo-model": "workspace:*",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "remotion": "4.0.489",
    "three": "^0.183.2"
  },
  "devDependencies": {
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.183.1",
    "@types/web": "0.0.166"
  }
}
