{
  "name": "@samebase/remotion-studio",
  "version": "0.0.0",
  "private": true,
  "description": "Samebase motion design and video composition workbench",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "remotion bundle",
    "dev": "remotion studio",
    "generate:subtitles": "node src/scripts/generateRecordedDemoSubtitles.ts",
    "generate:scout-subtitles": "node src/scripts/generateRecordedDemoSubtitles.ts scout",
    "render:founder-demo": "remotion render FounderDemo out/founder-demo-master.mp4",
    "render:founder-demo-youtube": "remotion render FounderDemoYouTube out/founder-demo-youtube.mp4",
    "render:contact-sheet": "node src/scripts/renderContactSheet.ts",
    "render:logo-hype": "remotion render LogoHype out/logo-hype.mp4",
    "render:look-again-riso": "remotion render SamebaseLookAgainRiso out/look-again-riso.mp4 --concurrency=1",
    "render:look-again-riso-video": "remotion render SamebaseLookAgainRisoVideo out/look-again-riso-video.mp4 --concurrency=1 --muted",
    "render:look-again-preview": "remotion render SamebaseLookAgainPreview out/look-again-preview.mp4 --concurrency=1",
    "render:mark-illusion-test": "remotion render MarkIllusionTest out/mark-illusion-test.mp4",
    "render:menger-dive-spike": "remotion render MengerDiveSpike out/menger-dive-spike.mp4",
    "render:menger-scale-stills": "remotion still MengerScaleStill-1 out/menger-scale-still-1.png && remotion still MengerScaleStill-2 out/menger-scale-still-2.png && remotion still MengerScaleStill-3 out/menger-scale-still-3.png",
    "render:samebase-riso-film": "remotion render SamebaseRisoFilm out/samebase-riso-film.mp4",
    "render:samebase-riso-film-portrait": "remotion render SamebaseRisoFilmPortrait out/samebase-riso-film-4x5.mp4",
    "render:samebase-riso-loop": "remotion render SamebaseRisoLoop out/samebase-riso-loop.mp4",
    "render:onboarding-demo": "remotion render OnboardingDemo out/onboarding-demo-youtube.mp4",
    "render:scout-demo": "remotion render ScoutDemo out/scout-demo-master.mp4",
    "render:tic-tac-toe": "remotion render TicTacToeRecording out/tic-tac-toe-master.mp4"
  },
  "dependencies": {
    "@react-three/fiber": "9.6.1",
    "@remotion/bundler": "4.0.489",
    "@remotion/captions": "4.0.489",
    "@remotion/cli": "4.0.489",
    "@remotion/google-fonts": "4.0.489",
    "@remotion/renderer": "4.0.489",
    "@remotion/three": "4.0.489",
    "@samebase/logo-model": "workspace:*",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "remotion": "4.0.489",
    "three": "^0.183.2",
    "typegpu": "0.12.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.9",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.183.1",
    "@types/web": "0.0.166",
    "unplugin-typegpu": "0.12.1"
  }
}
