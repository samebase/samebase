{
  "name": "noter-starter-template",
  "private": true,
  "version": "0.0.0",
  "license": "UNLICENSED",
  "packageManager": "pnpm@9.15.0",
  "type": "module",
  "scripts": {
    "dev": "npm-run-all --parallel dev:frontend dev:backend",
    "dev:frontend": "vp dev",
    "dev:backend": "convex dev",
    "build": "vp build",
    "build:frontend": "vp build",
    "preview": "vp preview",
    "lint": "tsc --noEmit && pnpm --dir ../.. exec eslint apps/noter-starter-template --ext ts,tsx --report-unused-disable-directives --config .eslintrc.cjs",
    "test": "vitest run --passWithNoTests",
    "prepare": "husky",
    "template:sync-codespace": "node scripts/sync-codespace-assets.mjs",
    "template:export": "node scripts/export-template-manifest.mjs"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-slot": "^1.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "1.34.1",
    "lucide-react": "^0.525.0",
    "npm-run-all": "^4.1.5",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwind-merge": "^2.5.2"
  },
  "devDependencies": {
    "@playwright/cli": "^0.1.1",
    "@convex-dev/eslint-plugin": "0.0.1-alpha.4",
    "@typescript-eslint/eslint-plugin": "^7.13.1",
    "@typescript-eslint/parser": "^7.13.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^6.1.1",
    "eslint-plugin-react-refresh": "^0.4.7",
    "husky": "^9.1.7",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.14",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "5.9.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "^4.1.4"
  }
}
