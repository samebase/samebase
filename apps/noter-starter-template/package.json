{
  "name": "noter-starter-template",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "npm-run-all --parallel dev:frontend dev:backend",
    "dev:frontend": "vp dev",
    "dev:backend": "convex dev",
    "build": "vp build",
    "build:frontend": "vp build",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "preview": "vp preview",
    "typecheck": "tsgo -b --pretty false",
    "lint": "pnpm run typecheck && NODE_OPTIONS=--max-old-space-size=4096 pnpm --dir ../.. exec oxlint --config .oxlintrc.json --report-unused-disable-directives apps/noter-starter-template",
    "test": "vp test run --passWithNoTests",
    "prepare": "husky",
    "template:sync-codespace": "node scripts/sync-codespace-assets.mjs",
    "template:export": "node scripts/export-template-manifest.mjs"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-slot": "^1.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "1.34.1",
    "lucide-react": "^0.525.0",
    "npm-run-all": "^4.1.5",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwind-merge": "^2.5.2"
  },
  "devDependencies": {
    "@playwright/cli": "^0.1.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript/native-preview": "7.0.0-dev.20260413.1",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.4.20",
    "husky": "^9.1.7",
    "oxfmt": "0.44.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.14",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "5.9.2",
    "vite": "^8.0.8",
    "vite-plus": "0.1.16",
    "vitest": "^4.1.4"
  },
  "packageManager": "pnpm@9.15.0"
}
