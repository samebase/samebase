    "openapi-typescript": "^7.13.0",
    "pixelmatch": "^7.1.0",
    "pngjs": "^7.0.0",
    "shadcn": "^4.4.0",
    "tailwindcss": "^4.2.2",
    "typescript": "5.9.2",
    "unplugin-typegpu": "0.12.1",
    "vite": "catalog:",
