    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "^12.10.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "codemirror": "^6.0.1",
    "convex": "1.45.0",
    "convex-helpers": "^0.1.123",
    "diff": "^8.0.4",
    "html-to-image": "^1.11.13",
    "lossless-json": "^4.3.0",
    "lucide-react": "^0.525.0",
    "minimatch": "^10.2.5",
