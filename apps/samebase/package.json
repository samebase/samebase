  "type": "module",
  "scripts": {
    "dev": "pnpm run dev:raw",
    "dev:raw": "concurrently --kill-others-on-fail --names frontend,backend \"pnpm run dev:frontend\" \"pnpm run dev:backend\"",
    "dev:frontend": "node ./scripts/run-vite-dev.ts",
    "dev:backend": "node ./scripts/convex-dev.ts",
    "generate:cloudflare-api": "node ./scripts/generate-cloudflare-api.ts",
    "verify:cloudflare-api": "node ./scripts/generate-cloudflare-api.ts --verify",
    "generate:convex-management-api": "node ./scripts/generate-convex-management-api.ts",
    "verify:convex-management-api": "node ./scripts/generate-convex-management-api.ts --verify",
    "generate:logo-assets": "node ./scripts/generate-install-icon-assets.ts",
    "generate:install-icon-assets": "node ./scripts/generate-install-icon-assets.ts",
    "generate:action-docs": "node ./scripts/generate-action-docs.ts",
    "verify:logo-assets": "pnpm run generate:logo-assets && git diff --exit-code -- public/brand public/favicon.png public/favicon-32.png public/logo-v1-side-primary.svg public/logo-v2-side-diagonal.svg public/logo-static.svg public/samebase-icon.svg public/install-icon.svg public/apple-touch-icon.png public/icon-192.png public/icon-512.png public/icon-maskable-192.png public/icon-maskable-512.png public/chatgpt-app-icon.png public/chatgpt-app-icon-dark.png public/samebase-social-card.svg public/samebase-social-card.png public/samebase-x-profile-banner.svg public/samebase-x-profile-banner.png ../../packages/plugin/plugins/samebase/assets/icon.png ../../templates/base/public/favicon.svg",
    "verify:install-icon-assets": "pnpm run verify:logo-assets",
    "verify:action-docs": "pnpm run generate:action-docs && git diff --exit-code -- public/docs/actions public/llms.txt ../../chatgpt-app-submission.json ../../packages/plugin/plugins/samebase/.codex-plugin/plugin.json",
    "predev": "node ./scripts/predev.ts",
    "check": "convex codegen && tsgo --noEmit && pnpm run lint:vp && pnpm run verify:action-docs",
    "check:ci": "tsgo --noEmit && pnpm run lint:vp && pnpm run verify:action-docs",
    "typecheck": "convex codegen && tsgo --noEmit",
    "typecheck:watch": "tsgo --watch",
    "build:app": "convex codegen && pnpm run build:ci",
    "build:ci": "tsgo && vp build",
    "deploy": "convex-hosting deploy --dist dist/client --html-handling drop-trailing-slash --not-found-handling none --build \"pnpm run build:ci\"",
    "lint": "pnpm run check",
    "lint:ci": "pnpm run check:ci",
    "lint:vp": "NODE_OPTIONS=--max-old-space-size=4096 pnpm --dir ../.. exec vp lint --report-unused-disable-directives apps/samebase",
    "test:logo-research": "playwright test -c playwright.logo-research.config.ts",
    "test:opt-in": "playwright test -c playwright.opt-in.config.ts",
    "test:visual": "playwright test -c playwright.config.ts",
    "test:webgpu": "playwright test -c playwright.webgpu.config.ts",
    "test:live": "playwright test -c playwright.live.config.ts",
    "preview": "vp preview"
  },
