# Rules for the files of the build: the prerendered pages and the assets. A page that the server
# renders gets its headers from src/start.ts.
/*
  Content-Security-Policy: frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY

/docs/*.md
  X-Robots-Tag: noindex, follow

/pricing.md
  X-Robots-Tag: noindex, follow

/changelog.md
  X-Robots-Tag: noindex, follow

/assets/*
  Cache-Control: public, max-age=31536000, immutable
