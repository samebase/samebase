{
  "name": "@samebase/sidebars-example",
  "version": "0.0.0",
  "private": true,
  "description": "Single-page @samebase/sidebars example with two sidebar panes",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samebase/sidebars-example.git"
  },
  "type": "module",
  "scripts": {
    "build": "vp run build:app",
    "build:app": "vp build",
    "check": "vp check && vp run typecheck && vp test && vp run build:app",
    "deploy": "wrangler deploy",
    "deploy:preview": "wrangler preview",
    "deploy:dry-run": "vp run build:app && wrangler deploy --dry-run",
    "dev": "vp dev",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "lint": "vp lint --report-unused-disable-directives",
    "preview": "vp preview",
    "typecheck": "tsgo --noEmit"
  },
  "dependencies": {
    "@samebase/sidebars": "0.1.2",
    "@tanstack/react-router": "1.170.44",
    "@tanstack/react-start": "1.169.1",
    "lucide-react": "0.577.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tanstack/router-plugin": "1.168.45",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.2",
    "typescript": "6.0.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.1.0",
    "vite-plus": "1.1.0",
    "wrangler": "4.151.0"
  },
  "engines": {
    "node": ">=24.11.0",
    "pnpm": ">=12"
  },
  "packageManager": "pnpm@12.14.0"
}
