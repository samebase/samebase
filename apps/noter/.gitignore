# Keep broadly aligned with repo-root .gitignore so this app can be extracted cleanly.

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Dependencies
node_modules
.pnp
.pnp.js

# Production builds
dist
dist-ssr
build
.next

# Coverage
coverage
.nyc_output

# Tooling caches
*.tsbuildinfo
.turbo
.vite

# Environment variables
*.local
.env
.env.local
.env.production.local
.env.development.local

# Convex
convex/.tmp
.convex

# Hosting tooling
.netlify
.vercel

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Package manager lockfiles (keeping pnpm-lock.yaml)
package-lock.json
yarn.lock

# Local notes
todo.md
