{
  "name": "noter",
  "private": true,
  "version": "0.0.0",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "npm-run-all --parallel dev:frontend dev:backend",
    "dev:frontend": "vite --host 0.0.0.0 --port ${VITE_PORT:-5173}",
    "dev:backend": "node convex-dev.js",
    "predev": "node predev.js",
    "typecheck": "convex codegen && tsc --noEmit",
    "build": "convex codegen && tsc && vite build",
    "build:ci": "tsc && vite build",
    "build:vercel": "vite build",
    "lint": "convex codegen && tsc --noEmit && cd ../.. && NODE_OPTIONS=--max-old-space-size=4096 eslint apps/noter --ext ts,tsx --report-unused-disable-directives --config .eslintrc.cjs --rulesdir eslint-rules",
    "lint:ci": "tsc --noEmit && cd ../.. && NODE_OPTIONS=--max-old-space-size=4096 eslint apps/noter --ext ts,tsx --report-unused-disable-directives --config .eslintrc.cjs --rulesdir eslint-rules",
    "test:visual": "playwright test -c playwright.config.ts",
    "test:live": "playwright test -c playwright.live.config.ts",
    "preview": "vite preview"
  },
