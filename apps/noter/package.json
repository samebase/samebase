    "@vitejs/plugin-react": "^6.0.1",
    "dotenv": "^16.4.5",
    "jsdom": "^29.0.1",
    "npm-run-all": "^4.1.5",
    "pixelmatch": "^7.1.0",
    "pngjs": "^7.0.0",
    "shadcn": "^4.4.0",
    "tailwindcss": "^4.2.2",
    "typescript": "5.9.2",
    "vite": "^8.0.8",
    "vite-plus": "0.1.16"
  }
}
