{
  "name": "noter",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "npm-run-all --parallel dev:frontend dev:backend",
    "dev:frontend": "node ./scripts/run-vite-dev.ts",
    "dev:backend": "node ./scripts/convex-dev.ts",
    "generate:install-icon-assets": "node ./scripts/generate-install-icon-assets.ts",
    "verify:install-icon-assets": "npm run generate:install-icon-assets && git diff --exit-code -- public/install-icon.svg public/apple-touch-icon.png public/icon-192.png public/icon-512.png public/icon-maskable-192.png public/icon-maskable-512.png",
    "predev": "node ./scripts/predev.ts",
    "check": "convex codegen && tsgo --noEmit && pnpm run lint:vp",
    "check:ci": "tsgo --noEmit && pnpm run lint:vp",
    "typecheck": "convex codegen && tsgo --noEmit",
    "typecheck:watch": "tsgo --watch",
    "build": "convex codegen && tsgo && vp build",
    "build:cloudflare": "if [ -n \"$CF_PAGES_BRANCH\" ] && [ \"$CF_PAGES_BRANCH\" != \"main\" ]; then pnpm run build:cloudflare:preview; else pnpm run build:cloudflare:production; fi",
    "build:cloudflare:production": "pnpm exec convex deploy --cmd 'pnpm run build:ci'",
    "build:cloudflare:preview": "pnpm exec convex deploy --preview-create \"$CF_PAGES_BRANCH\" --preview-run devAuth:seedPasswordAccount --cmd 'pnpm run build:ci'",
    "build:ci": "tsgo && vp build",
    "build:vercel": "vp build",
    "lint": "pnpm run check",
    "lint:ci": "pnpm run check:ci",
    "lint:vp": "NODE_OPTIONS=--max-old-space-size=4096 pnpm --dir ../.. exec vp lint --report-unused-disable-directives apps/noter",
    "test:visual": "playwright test -c playwright.config.ts",
    "test:live": "playwright test -c playwright.live.config.ts",
    "preview": "vp preview"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^2.0.66",
    "@auth/core": "^0.37.0",
    "@base-ui/react": "^1.4.1",
    "@codemirror/collab": "^6.1.1",
    "@codemirror/commands": "^6.8.0",
    "@codemirror/lang-css": "^6.2.1",
    "@codemirror/lang-html": "^6.4.9",
    "@codemirror/lang-javascript": "^6.2.2",
    "@codemirror/lang-json": "^6.0.1",
    "@codemirror/lang-markdown": "^6.3.1",
    "@codemirror/lang-python": "^6.1.6",
    "@codemirror/language": "^6.10.8",
    "@codemirror/language-data": "^6.5.1",
    "@codemirror/merge": "^6.12.0",
    "@codemirror/state": "^6.4.1",
    "@codemirror/theme-one-dark": "^6.1.2",
    "@codemirror/view": "^6.28.4",
    "@convex-dev/agent": "^0.3.2",
    "@convex-dev/auth": "^0.0.88",
    "@convex-dev/eslint-plugin": "0.0.1-alpha.4",
    "@daytonaio/api-client": "^0.143.0",
    "@daytonaio/sdk": "^0.143.0",
    "@fontsource/ibm-plex-sans": "^5.2.8",
    "@lezer-unofficial/printer": "^1.0.1",
    "@lezer/markdown": "^1.4.0",
    "@monaco-editor/react": "^4.7.0",
    "@noter-md/dependent": "workspace:*",
    "@octokit/rest": "^22.0.0",
    "@polar-sh/sdk": "^0.46.0",
    "@prosemark/core": "^0.0.7",
    "@robolex/sure": "^0.12.0",
    "@tanstack/react-query": "^5.83.0",
    "@tanstack/react-query-devtools": "^5.83.0",
    "@tanstack/react-router": "^1.168.10",
    "@typescript/ata": "^0.9.8",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "^12.10.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "codemirror": "^6.0.1",
    "convex": "1.36.1",
    "convex-helpers": "^0.1.111",
    "diff": "^8.0.4",
    "html-to-image": "^1.11.13",
    "isomorphic-git": "^1.33.0",
    "lucide-react": "^0.525.0",
    "minimatch": "^10.2.5",
    "next-themes": "^0.4.6",
    "posthog-js": "^1.367.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
