{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "samebase-domains",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-14",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true,
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1,
    },
  },
  "routes": [
    {
      "pattern": "*.json.md/*",
      "zone_name": "json.md",
    },
    {
      "pattern": "*.xml.md/*",
      "zone_name": "xml.md",
    },
  ],
}
