{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "samebase-domains",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-14",
  "routes": [
    {
      "pattern": "*.json.md/*",
      "zone_name": "json.md",
    },
    {
      "pattern": "*.xml.md/*",
      "zone_name": "xml.md",
    },
  ],
}
