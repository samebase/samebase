{
  "name": "noter-monorepo",
  "private": true,
  "version": "1.0.0",
  "description": "noter monorepo with Vite+ and PNPM",
  "packageManager": "pnpm@9.15.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "node ./scripts/run-primary-dev.js",
    "build": "vp run --filter noter build",
    "build:ci": "vp run --filter noter build:ci",
    "lint": "vp run --filter noter lint && pnpm typecheck:scripts && pnpm lint:scripts",
    "lint:ci": "vp run --filter noter lint:ci && pnpm typecheck:scripts && pnpm lint:scripts",
    "ci:convex-bootstrap": "CONVEX_AGENT_MODE=anonymous pnpm --filter noter exec convex dev --until-success --typecheck=disable --tail-logs=disable",
    "format": "vp fmt .",
    "preview": "vp run --filter noter preview",
    "export:pitch-deck:pdf": "pnpm --filter noter build:ci && node scripts/export-pitch-deck.mjs",
    "clean": "node ./scripts/clean-workspace.js",
    "test": "vp test",
    "test:ci": "pnpm test && PLAYWRIGHT_VITE_PORT=43121 pnpm --filter noter test:visual",
    "test:watch": "vp test watch",
    "dev:noter": "node ./scripts/run-primary-dev.js",
    "build:noter": "vp run --filter noter build",
    "lint:noter": "vp run --filter noter lint",
    "dev:starter": "vp run --filter noter-starter-template dev",
    "build:starter": "vp run --filter noter-starter-template build",
    "lint:starter": "vp run --filter noter-starter-template lint",
    "prepare": "vp config",
    "daytona:refresh": "bash scripts/daytona-refresh.sh",
    "daytona:runtime:manifest": "node scripts/daytona-runtime-manifest.js",
    "daytona:runtime:compare": "node scripts/daytona-compare-runtime.js",
    "daytona:runtime:render": "node scripts/render-daytona-runtime.js",
    "daytona:runtime:check": "node scripts/render-daytona-runtime.js --check",
    "lint:scripts": "pnpm exec eslint runtime scripts --ext js --config .eslintrc.cjs",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json --pretty false"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@robolex/sure": "^0.12.0",
    "commander": "^14.0.3",
    "eslint-plugin-noter-local": "workspace:*",
    "typescript": "5.9.2",
    "vite-plus": "catalog:"
  },
  "keywords": [
    "monorepo",
    "vite-plus",
    "react",
    "vite",
    "convex"
  ],
  "author": "",
  "license": "UNLICENSED"
}
