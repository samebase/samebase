{
  "name": "workfir-monorepo",
  "private": true,
  "version": "1.0.0",
  "description": "WorkFir monorepo with Turborepo and PNPM",
  "packageManager": "pnpm@8.12.0",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "preview": "turbo run preview",
    "clean": "turbo run clean",
    "dev:workfir": "turbo run dev --filter=workfir",
    "build:workfir": "turbo run build --filter=workfir",
    "lint:workfir": "turbo run lint --filter=workfir"
  },
  "devDependencies": {
    "turbo": "^2.5.5",
    "typescript": "5.9.2"
  },
  "keywords": [
    "monorepo",
    "turborepo",
    "react",
    "vite",
    "convex"
  ],
  "author": "",
  "license": "MIT"
}
