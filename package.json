{
  "name": "noter-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "noter monorepo with PNPM and Vite+ tooling",
  "keywords": [
    "convex",
    "monorepo",
    "react",
    "vite",
    "vite-plus"
  ],
  "license": "UNLICENSED",
  "author": "",
  "type": "module",
  "scripts": {
    "anon": "node ./scripts/run-anon-dev.ts",
    "anon:once": "node ./scripts/run-anon-dev.ts --once",
    "bootstrap": "node ./scripts/bootstrap-worktree.ts",
    "connect": "node ./scripts/noter-pr-connect.ts",
    "connect:once": "node ./scripts/noter-pr-connect.ts --once",
    "dev": "node ./scripts/run-primary-dev.ts",
    "build": "vp run --filter noter build",
    "build:ci": "vp run --filter noter build:ci",
    "check": "pnpm run check:workspace && pnpm run check:root",
    "check:ci": "pnpm run check:workspace:ci && pnpm run check:root",
    "check:packages": "pnpm --filter @noter-md/dependent check && pnpm --filter @noter-md/onboarding-video-tools check",
    "check:workspace": "vp run --filter noter check && pnpm run check:packages",
    "check:workspace:ci": "vp run --filter noter check:ci && pnpm run check:packages",
    "check:root": "pnpm run check:scripts",
    "check:scripts": "pnpm run typecheck:scripts && pnpm run lint:scripts",
    "typecheck": "pnpm --filter noter typecheck && pnpm run typecheck:packages && pnpm typecheck:scripts",
    "typecheck:packages": "pnpm --filter @noter-md/dependent typecheck && pnpm --filter @noter-md/onboarding-video-tools typecheck",
    "lint": "pnpm run check",
    "lint:ci": "pnpm run check:ci",
    "ci:convex-bootstrap": "CONVEX_AGENT_MODE=anonymous pnpm --filter noter exec convex dev --until-success --typecheck=disable --tail-logs=disable",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "preview": "vp run --filter noter preview",
    "export:pitch-deck:pdf": "pnpm --filter noter build:ci && node scripts/export-pitch-deck.ts",
    "clean": "rm -rf .turbo .vite coverage test-results apps/noter/dist apps/noter/dev-dist apps/noter/e2e/test-results apps/noter/e2e/live-test-results",
    "test": "vp test",
    "test:ci": "pnpm test && PLAYWRIGHT_VITE_PORT=43121 pnpm --filter noter test:visual",
    "test:convex": "vp test --project convex",
    "test:visual:linux": "node ./scripts/playwright-linux-docker.ts",
    "test:watch": "vp test watch",
    "dev:noter": "node ./scripts/run-primary-dev.ts",
    "build:noter": "vp run --filter noter build",
    "check:noter": "vp run --filter noter check",
    "lint:noter": "pnpm run check:noter",
    "template:export": "node scripts/export-notermd-app-manifest.ts",
    "prepare": "vp config --hooks-dir .vite-hooks",
    "fixtures:update": "node ./scripts/update-simple-view-fixtures.ts",
    "killport": "node ./scripts/killport.ts",
    "lint:scripts": "pnpm exec vp lint --tsconfig tsconfig.scripts.json --report-unused-disable-directives runtime scripts .devcontainer/postcreate.ts apps/noter/scripts apps/noter/postcss.config.ts apps/noter/tailwind.config.ts",
    "playwright:open": "node ./scripts/playwright-session.ts open",
    "playwright:record:start": "node ./scripts/playwright-session.ts record-start",
    "playwright:record:stop": "node ./scripts/playwright-session.ts record-stop",
    "onboarding-video:landing-demo": "pnpm --filter @noter-md/onboarding-video-tools landing-demo",
    "onboarding-video:screen-demo": "pnpm --filter @noter-md/onboarding-video-tools screen-demo",
    "share:anon": "node ./scripts/anon-share.ts",
    "share:local": "node ./scripts/anon-share.ts --mode local",
    "typecheck:scripts": "tsgo -p tsconfig.scripts.json --pretty false"
  },
  "devDependencies": {
    "@convex-dev/eslint-plugin": "2.0.0",
    "@edge-runtime/vm": "^5.0.0",
    "@playwright/test": "1.58.2",
    "@robolex/sure": "^0.12.0",
    "@typescript/native-preview": "7.0.0-dev.20260413.1",
    "convex-test": "^0.0.51",
    "eslint-plugin-react-refresh": "^0.4.7",
    "typescript": "5.9.2",
    "vite-plus": "0.1.16"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.0"
}
