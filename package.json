{
  "name": "lumina-monorepo",
  "private": true,
  "version": "1.0.0",
  "description": "Lumina monorepo with Turborepo and PNPM",
  "packageManager": "pnpm@8.12.0",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "preview": "turbo run preview",
    "clean": "turbo run clean",
    "dev:lumina": "turbo run dev --filter=lumina",
    "build:lumina": "turbo run build --filter=lumina",
    "lint:lumina": "turbo run lint --filter=lumina"
  },
  "devDependencies": {
    "turbo": "^2.5.5"
  },
  "keywords": [
    "monorepo",
    "turborepo",
    "react",
    "vite",
    "convex"
  ],
  "author": "",
  "license": "MIT"
}
