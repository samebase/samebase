{
  "name": "noter-monorepo",
  "private": true,
  "version": "1.0.0",
  "description": "noter monorepo with pnpm workspaces",
  "packageManager": "pnpm@9.15.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter noter dev",
    "build": "pnpm --filter noter build",
    "build:ci": "pnpm --filter noter build:ci",
    "lint": "pnpm --filter noter lint && pnpm typecheck:scripts && pnpm lint:scripts",
    "lint:ci": "pnpm --filter noter lint:ci && pnpm typecheck:scripts && pnpm lint:scripts",
    "ci:convex-bootstrap": "CONVEX_AGENT_MODE=anonymous pnpm --filter noter exec convex dev --until-success --typecheck=disable --tail-logs=disable",
    "format": "prettier --write .",
    "preview": "pnpm --filter noter build && pnpm --filter noter preview",
    "clean": "rm -rf .turbo apps/noter/.turbo apps/noter-starter-template/.turbo apps/noter/dist apps/noter-starter-template/dist apps/noter/.vite apps/noter-starter-template/.vite apps/noter/.next apps/noter-starter-template/.next",
    "test": "vitest --run",
    "test:watch": "vitest",
    "dev:noter": "pnpm --filter noter dev",
    "build:noter": "pnpm --filter noter build",
    "lint:noter": "pnpm --filter noter lint",
    "dev:starter": "pnpm --filter noter-starter-template dev",
    "build:starter": "pnpm --filter noter-starter-template build",
    "lint:starter": "pnpm --filter noter-starter-template lint",
    "prepare": "husky",
    "daytona:refresh": "bash scripts/daytona-refresh.sh",
    "daytona:runtime:manifest": "node scripts/daytona-runtime-manifest.js",
    "daytona:runtime:compare": "node scripts/daytona-compare-runtime.js",
    "daytona:runtime:render": "node scripts/render-daytona-runtime.js",
    "daytona:runtime:check": "node scripts/render-daytona-runtime.js --check",
    "lint:scripts": "pnpm exec eslint runtime scripts --ext js --config .eslintrc.cjs --rulesdir eslint-rules",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json --pretty false"
  },
  "devDependencies": {
    "@robolex/sure": "^0.12.0",
    "commander": "^14.0.3",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "3.3.2",
    "typescript": "5.9.2",
    "vitest": "^1.0.0"
  },
  "lint-staged": {
    "*.{cjs,css,html,js,json,jsx,md,mdx,mjs,scss,ts,tsx}": "prettier --write"
  },
  "keywords": [
    "monorepo",
    "pnpm",
    "react",
    "vite",
    "convex"
  ],
  "author": "",
  "license": "UNLICENSED",
  "pnpm": {
    "patchedDependencies": {
      "convex@1.32.0": "patches/convex@1.32.0.patch"
    }
  }
}
