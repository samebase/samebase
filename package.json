{
  "name": "noter-monorepo",
  "private": true,
  "version": "1.0.0",
  "description": "noter monorepo with Turborepo and PNPM",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "preview": "turbo run preview",
    "clean": "turbo run clean",
    "test": "vitest",
    "dev:noter": "turbo run dev --filter=noter",
    "build:noter": "turbo run build --filter=noter",
    "lint:noter": "turbo run lint --filter=noter",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "turbo": "^2.5.5",
    "typescript": "5.9.2",
    "vitest": "^1.0.0"
  },
  "keywords": [
    "monorepo",
    "turborepo",
    "react",
    "vite",
    "convex"
  ],
  "author": "",
  "license": "MIT"
}
