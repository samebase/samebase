{
  "name": "noter-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "noter monorepo with Turborepo and PNPM",
  "keywords": [
    "convex",
    "monorepo",
    "react",
    "turborepo",
    "vite"
  ],
  "license": "UNLICENSED",
  "author": "",
  "type": "module",
  "scripts": {
    "dev": "node ./scripts/run-primary-dev.js",
    "build": "turbo run build --filter=noter",
    "build:ci": "turbo run build:ci --filter=noter",
    "lint": "turbo run lint --filter=noter && pnpm typecheck:scripts && pnpm lint:scripts",
    "lint:ci": "turbo run lint:ci --filter=noter && pnpm typecheck:scripts && pnpm lint:scripts",
    "ci:convex-bootstrap": "CONVEX_AGENT_MODE=anonymous pnpm --filter noter exec convex dev --until-success --typecheck=disable --tail-logs=disable",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "preview": "turbo run preview",
    "export:pitch-deck:pdf": "pnpm --filter noter build:ci && node scripts/export-pitch-deck.mjs",
    "clean": "turbo run clean",
    "test": "vitest --run",
    "test:ci": "pnpm test && PLAYWRIGHT_VITE_PORT=43121 pnpm --filter noter test:visual",
    "test:watch": "vitest",
    "dev:noter": "node ./scripts/run-primary-dev.js",
    "build:noter": "turbo run build --filter=noter",
    "lint:noter": "turbo run lint --filter=noter",
    "dev:starter": "turbo run dev --filter=noter-starter-template",
    "build:starter": "turbo run build --filter=noter-starter-template",
    "lint:starter": "turbo run lint --filter=noter-starter-template",
    "prepare": "husky",
    "daytona:refresh": "bash scripts/daytona-refresh.sh",
    "daytona:runtime:manifest": "node scripts/daytona-runtime-manifest.js",
    "daytona:runtime:compare": "node scripts/daytona-compare-runtime.js",
    "daytona:runtime:render": "node scripts/render-daytona-runtime.js",
    "daytona:runtime:check": "node scripts/render-daytona-runtime.js --check",
    "lint:scripts": "pnpm exec oxlint --config .oxlintrc.json --tsconfig tsconfig.scripts.json --report-unused-disable-directives runtime scripts",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json --pretty false"
  },
  "devDependencies": {
    "@convex-dev/eslint-plugin": "0.0.1-alpha.4",
    "@playwright/test": "1.58.2",
    "@robolex/sure": "^0.12.0",
    "commander": "^14.0.3",
    "eslint-plugin-noter-local": "workspace:*",
    "eslint-plugin-react-refresh": "^0.4.7",
    "husky": "^9.1.7",
    "oxfmt": "0.44.0",
    "oxlint": "^1.59.0",
    "oxlint-tsgolint": "^0.20.0",
    "turbo": "^2.5.5",
    "typescript": "5.9.2",
    "vitest": "^1.0.0"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.0"
}
