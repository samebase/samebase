+/**
+ * Samebase patch for 2.0.0, part c. No upstream pull request covers it yet.
+ * Gap: the password component has no deletion by user id, so a deleted
+ * user's password hash stays.
+ *
+ * Delete the stored password and the verifyPassword rate limit of a user.
+ * Idempotent.
+ */
+export const deleteUser = mutation({
+  args: { userId: v.string() },
+  returns: v.null(),
+  handler: async (ctx, { userId }) => {
+    const row = await passwordByUserId(ctx, userId);
+    if (row !== null) {
+      await ctx.db.delete("passwords", row._id);
+    }
+    await rateLimiter.reset(ctx, "verifyPassword", { key: userId });
+    return null;
+  },
+});
