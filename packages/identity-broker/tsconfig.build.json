{
  // The published build: each entry of `publishConfig.exports`, the component's modules, and what they import.
  "extends": "./tsconfig.worker.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "rewriteRelativeImportExtensions": true,
    "rootDir": "./src",
    "outDir": "./dist"
  },
  "include": ["src/hosts/convex/component/**/*.ts"],
  "files": [
    "src/index.ts",
    "src/hosts/convex/hub.ts",
    "src/hosts/cloudflare/hub.ts",
    "src/core/connectors/index.ts",
    "src/connections/index.ts",
    "src/moderation/server.ts",
    "src/moderation/api.ts",
    "src/core/testing/harness.ts"
  ]
}
