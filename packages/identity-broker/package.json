{
  "name": "@samebase/identity-broker",
  "version": "0.43.0",
  "description": "An OpenID Provider that holds a team's upstream sign-in connections once and keeps no user accounts. It runs on any platform with your own storage, with ready hosts for Convex and Cloudflare.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samebase/samebase.git",
    "directory": "packages/identity-broker"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./convex.config": "./src/hosts/convex/component/convex.config.ts",
    "./_generated/component.js": "./src/hosts/convex/component/_generated/component.ts",
    "./convex": "./src/hosts/convex/broker.ts",
    "./cloudflare": "./src/hosts/cloudflare/broker.ts",
    "./client": "./src/client/index.ts",
    "./client-runtime": "./src/client/runtime.ts",
    "./connectors": "./src/core/connectors/index.ts",
    "./connections": "./src/connections/index.ts",
    "./registration": "./src/layers/index.ts",
    "./moderation": "./src/moderation/server.ts",
    "./moderation/api": "./src/moderation/api.ts",
    "./testing": "./src/core/testing/harness.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./convex.config": {
        "types": "./dist/hosts/convex/component/convex.config.d.ts",
        "default": "./dist/hosts/convex/component/convex.config.js"
      },
      "./_generated/component.js": {
        "types": "./dist/hosts/convex/component/_generated/component.d.ts"
      },
      "./convex": {
        "types": "./dist/hosts/convex/broker.d.ts",
        "default": "./dist/hosts/convex/broker.js"
      },
      "./cloudflare": {
        "types": "./dist/hosts/cloudflare/broker.d.ts",
        "default": "./dist/hosts/cloudflare/broker.js"
      },
      "./client": {
        "types": "./dist/client/index.d.ts",
        "default": "./dist/client/index.js"
      },
      "./client-runtime": {
        "types": "./dist/client/runtime.d.ts",
        "default": "./dist/client/runtime.js"
      },
      "./connectors": {
        "types": "./dist/core/connectors/index.d.ts",
        "default": "./dist/core/connectors/index.js"
      },
      "./connections": {
        "types": "./dist/connections/index.d.ts",
        "default": "./dist/connections/index.js"
      },
      "./registration": {
        "types": "./dist/layers/index.d.ts",
        "default": "./dist/layers/index.js"
      },
      "./moderation": {
        "types": "./dist/moderation/server.d.ts",
        "default": "./dist/moderation/server.js"
      },
      "./moderation/api": {
        "types": "./dist/moderation/api.d.ts",
        "default": "./dist/moderation/api.js"
      },
      "./testing": {
        "types": "./dist/core/testing/harness.d.ts",
        "default": "./dist/core/testing/harness.js"
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "prepack": "pnpm run build",
    "typecheck": "tsc --noEmit --project tsconfig.worker.json && tsc --noEmit --project tsconfig.node.json",
    "lint": "pnpm --dir ../.. exec vp lint --tsconfig packages/identity-broker/tsconfig.node.json --report-unused-disable-directives packages/identity-broker/src packages/identity-broker/alchemy.run.ts packages/identity-broker/scripts packages/identity-broker/test",
    "conformance": "node test/conformance/run.ts",
    "test": "pnpm --dir ../.. exec vp test run --project identity-broker --project identity-broker-client --project identity-broker-machine",
    "test:quick": "pnpm --dir ../.. exec vp test run --project identity-broker --project identity-broker-client",
    "test:convex": "vp test run test/convex-app",
    "generate:convex": "node scripts/generate-convex-functions.ts",
    "check": "node scripts/generate-convex-functions.ts --check && pnpm run typecheck && pnpm run lint && pnpm run test:quick && pnpm run build",
    "deploy": "alchemy deploy",
    "destroy": "alchemy destroy"
  },
  "dependencies": {
    "jose": "6.2.13",
    "oauth4webapi": "3.8.8"
  },
  "devDependencies": {
    "@alchemy.run/cloudflare": "2.0.0-beta.87",
    "@alchemy.run/test": "2.0.0-beta.87",
    "@cloudflare/workers-types": "5.20261028.1",
    "@effect/vitest": "4.1.4",
    "@types/node": "24.19.2",
    "alchemy": "2.0.0-beta.87",
    "convex": "1.48.0",
    "convex-test": "0.0.61",
    "effect": "4.1.4",
    "fast-check": "4.10.2",
    "openid-client": "6.8.8",
    "typescript": "7.0.2",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@alchemy.run/cloudflare": "2.0.0-beta.87",
    "alchemy": "2.0.0-beta.87",
    "convex": "^1.48.0",
    "effect": "^4.1.4",
    "fast-check": "^4.10.2"
  },
  "peerDependenciesMeta": {
    "@alchemy.run/cloudflare": {
      "optional": true
    },
    "alchemy": {
      "optional": true
    },
    "convex": {
      "optional": true
    },
    "fast-check": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24.11.0"
  }
}
