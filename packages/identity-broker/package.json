{
  "name": "@samebase/identity-broker",
  "version": "0.34.0",
  "description": "An OpenID Provider for Convex that holds a team's upstream sign-in connections once and keeps no user accounts.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samebase/samebase.git",
    "directory": "packages/identity-broker"
  },
  "bin": {
    "identity-broker": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "src/test.ts",
    "src/component",
    "!src/component/**/*.test.ts",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/client/index.d.ts",
      "samebase-source": "./src/client/index.ts",
      "default": "./dist/client/index.js"
    },
    "./convex.config": {
      "types": "./dist/component/convex.config.d.ts",
      "default": "./dist/component/convex.config.js"
    },
    "./_generated/component.js": {
      "types": "./dist/component/_generated/component.d.ts"
    },
    "./test": "./src/test.ts"
  },
  "scripts": {
    "build": "tsc --build ./tsconfig.build.json --force",
    "codegen": "convex codegen --component-dir ./src/component",
    "prepack": "pnpm run build",
    "typecheck": "tsc --noEmit",
    "lint": "pnpm --dir ../.. exec vp lint --tsconfig packages/identity-broker/tsconfig.json --report-unused-disable-directives packages/identity-broker/src",
    "test": "pnpm --dir ../.. exec vp test run --project identity-broker",
    "pages": "node --watch ./scripts/pages.ts",
    "test:pages": "node ../../scripts/playwright-linux-docker.ts --package packages/identity-broker",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run build && node ./dist/client/index.js"
  },
  "dependencies": {
    "@convex-dev/rate-limiter": "0.4.3",
    "convex-helpers": "0.1.134",
    "jose": "6.2.15",
    "oauth4webapi": "3.8.8"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "convex": "1.49.0",
    "convex-test": "0.0.67",
    "fast-check": "4.10.2",
    "openid-client": "6.8.9",
    "typescript": "7.0.2",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "convex": "^1.47.0"
  },
  "engines": {
    "node": ">=24.11.0"
  }
}
