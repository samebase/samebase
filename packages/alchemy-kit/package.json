{
  "name": "@samebase/alchemy-kit",
  "version": "0.7.0",
  "description": "A kit of parts for Alchemy v2: a state store on a branch of a GitHub repository, with sealed secrets, a run record in each stage output, and a name and icon for each resource type",
  "keywords": [
    "alchemy",
    "effect",
    "github",
    "infrastructure-as-code",
    "run-record",
    "state"
  ],
  "homepage": "https://github.com/samebase/samebase/tree/main/packages/alchemy-kit#readme",
  "bugs": {
    "url": "https://github.com/samebase/samebase/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samebase/samebase.git",
    "directory": "packages/alchemy-kit"
  },
  "files": [
    "lib",
    "src",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./github-state": "./src/github-state/GitHubState.ts",
    "./run-record": "./src/run-record/RunRecord.ts",
    "./ui": "./src/ui/ResourceTypeUI.ts",
    "./stack": "./src/stack/StackDiagram.ts"
  },
  "publishConfig": {
    "exports": {
      "./github-state": {
        "types": "./lib/github-state.d.ts",
        "import": "./lib/github-state.js"
      },
      "./run-record": {
        "types": "./lib/run-record.d.ts",
        "import": "./lib/run-record.js"
      },
      "./ui": {
        "types": "./lib/ui.d.ts",
        "import": "./lib/ui.js"
      },
      "./stack": {
        "types": "./lib/stack.d.ts",
        "import": "./lib/stack.js"
      }
    },
    "access": "public"
  },
  "scripts": {
    "check": "pnpm run typecheck && pnpm run lint && pnpm run ui:check && pnpm run test && pnpm run build",
    "ui:check": "node scripts/ui/check.ts",
    "ui:generate": "node scripts/ui/generate.ts",
    "typecheck": "tsc --noEmit",
    "test": "pnpm --dir ../.. exec vp test run --project alchemy-kit",
    "test:live": "vp test run test/github-state/live",
    "lint": "pnpm --dir ../.. exec vp lint --tsconfig packages/alchemy-kit/tsconfig.json --report-unused-disable-directives packages/alchemy-kit",
    "build": "vp pack",
    "prepack": "pnpm run build"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "0.18.5",
    "@types/node": "24.19.2",
    "alchemy": "https://pkg.alchemy.run/alchemy/pr:3167:61500d4",
    "effect": "4.1.4",
    "publint": "0.3.25",
    "typescript": "6.0.3",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "alchemy": "2.0.0-beta.87",
    "effect": "^4.1.4"
  },
  "engines": {
    "node": ">=22"
  }
}
