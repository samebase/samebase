{
  "name": "@noter-md/onboarding-video-tools",
  "version": "0.0.0",
  "private": true,
  "bin": {
    "noter-onboarding-video": "./cli.ts"
  },
  "files": [
    "cli.ts",
    "index.ts",
    "launchChromeLandingTabs.ts",
    "native"
  ],
  "type": "module",
  "scripts": {
    "landing-demo": "node --experimental-strip-types ./cli.ts landing-demo",
    "stack-step-1-signin": "node --experimental-strip-types ./cli.ts stack-step-1-signin",
    "stack-step-1-2": "node --experimental-strip-types ./cli.ts stack-step-1-2",
    "stack-full-run": "node --experimental-strip-types ./cli.ts stack-full-run",
    "screen-demo": "node --experimental-strip-types ./cli.ts screen-demo",
    "typecheck": "pnpm --dir ../.. exec tsgo -p packages/onboarding-video-tools/tsconfig.json --pretty false",
    "lint": "pnpm --dir ../.. exec oxlint --config .oxlintrc.json --tsconfig packages/onboarding-video-tools/tsconfig.json --report-unused-disable-directives packages/onboarding-video-tools/cli.ts packages/onboarding-video-tools/index.ts packages/onboarding-video-tools/launchChromeLandingTabs.ts",
    "check": "pnpm run typecheck && pnpm run lint"
  },
  "dependencies": {
    "@playwright/test": "1.58.2"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
